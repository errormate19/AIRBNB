<% layout("/layouts/boilerplate")%>

<div class="row">
  <div class="col-8 offest-2">
    <h3>Create a new listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="enter title"
          type="text"
          class="form-control"
          required
        />
      </div>

      <br />
      <br />

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          placeholder="enter description"
          type="text"
          required
        ></textarea>
      </div>

      <br />
      <br />

      <div class="mb-3">
        <label for="image" class="form-label">Image URL</label>
        <input
          name="listing[image]"
          class="form-control"
          placeholder="enter image URL/link"
          type="text"
          required
        />
      </div>
      <br />
      <br />

      <div class="row">
        <div class="mb-3 col-4">
          <label for="image" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="enter price"
            type="number"
            class="form-control"
            required
          />
        </div>

        <br />
        <br />

        <div class="mb-3 col-md-8">
          <label for="image" class="form-label">Country</label>
          <input
            name="listing[country]"
            placeholder="enter country"
            type="text"
            class="form-control"
            required
          />
          <br />
          <br />
        </div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Location</label>
        <input
          name="listing[location]"
          placeholder="enter location"
          type="text"
          class="form-control"
          required
        />
        <br />
        <br />
      </div>

      <button class="btn btn-dark add-btn mb-3">Add</button>
      <br />
    </form>
  </div>
</div>
