<% layout("/layouts/boilerplate")%>

<div class="row">
  <div class="col-8 offest-2">
    <h3>Edit your listing</h3>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
      <div class="mb-3 mt-3">
        <label for="image" class="form-label">Title</label>
        <input
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          class="form-control"
        />
        <br />
        <br />
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control">
<%= listing.description %></textarea
        >

        <br />
        <br />
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image</label>
        <input
          name="listing[image]"
          class="form-control"
          value="<%= listing.image.url %>"
          type="text"
        />
        <br />
        <br />
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            class="form-control"
            value="<%= listing.price %>"
            type="number"
          />
          <br />
          <br />
        </div>

        <div class="mb-3 col-md-8">
          <label for="location" class="form-label">Location</label>
          <input
            name="listing[location]"
            value="<%= listing.location %>"
            type="text"
            class="form-control"
          />
          <br />
          <br />
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Country</label>
        <input
          name="listing[country]"
          value="<%= listing.country %>"
          type="text"
          class="form-control"
        />
        <br />
        <br />
      </div>

      <button class="btn btn-dark edit-btn mb-3">Edit</button>
      <br />
    </form>
  </div>
</div>
